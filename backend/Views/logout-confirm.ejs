<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNIEats — Logout</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/colors.css">
    <link rel="stylesheet" href="/styles/app.css">
</head>
<body>

    <nav class="navbar">
        <a href="javascript:history.back()" class="back-arrow" aria-label="Go back">←</a>
        <div class="brand">
            <div class="logo">UNIEats</div>
            <span class="badge">Logout</span>
        </div>
        <div class="links">
            <a href="/">Home</a>
        </div>
    </nav>

    <main class="page-shell">
        <div class="form-card" style="text-align:center; max-width: 440px;">
            <h2 class="form-title">Leaving<br><em>Already?</em></h2>
            <p class="form-sub">You'll need to sign in again to access your account .</p>

            <div class="logout-actions">
                <button type="button" class="btn-cancel" onclick="window.history.back()">Stay Logged In</button>
                <button type="button" class="btn-logout" onclick="performLogout()">Yes, Logout</button>
            </div>
        </div>
    </main>

    <script>
        async function performLogout() {
            const btn = document.querySelector('.btn-logout');
            btn.textContent = 'Logging out…';
            btn.disabled = true;
            const token = localStorage.getItem('token');
            if (token) {
                try {
                    await fetch('/api/auth/logout', {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                } catch (_) {}
            }
            localStorage.clear();
            setTimeout(() => window.location.href = '/login', 800);
        }
    </script>
</body>
</html>