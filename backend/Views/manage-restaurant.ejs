<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UNIEats — Manage Restaurants</title>
  <link rel="stylesheet" href="/styles/colors.css">
  <link rel="stylesheet" href="/styles/admin.css">
</head>
<body>

  <nav class="navbar">
    <a href="/admin-dashboard" class="back-arrow" aria-label="Back to Dashboard">←</a>
    <span class="nav-logo">UNIEats</span>
    <div class="links">
      <a href="/admin-dashboard">Dashboard</a>
      <a href="/manage-restaurant" class="active">Restaurants</a>
      <a href="/manage-users">Users</a>
      <a href="/all-orders">Orders</a>
      <a href="#" onclick="confirmLogout(event)">Logout</a>
    </div>
  </nav>

  <div class="page-header">
    <p class="eyebrow">Admin Panel</p>
    <h1>Manage Restaurants 🏪</h1>
    <p class="page-subtitle">View and remove registered restaurants.</p>
  </div>

  <div class="container container-padded">
    <div class="card card-table">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Description</th>
              <th>ID</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="restaurantsTableBody">
            <tr>
              <td colspan="4" style="text-align:center;padding:48px;color:var(--text-muted);">
                Loading…
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="/script/admin.js"></script>
</body>
</html>
