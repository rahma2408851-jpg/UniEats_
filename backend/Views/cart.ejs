<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNIEats - Cart</title>
    <link rel="stylesheet" href="/styles/colors.css">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/student.css">
</head>

<body>
    <nav class="navbar">
        <a href="javascript:history.back()" class="back-arrow show" aria-label="Go back">←</a>
        <div class="links">
            <a href="/student-home">Home</a>
            <a href="/cart" class="active">Cart</a>
            <a href="/profile">Profile</a>
            <a href="#" onclick="confirmLogout(event)">Logout</a>
        </div>
    </nav>

    <main class="container cart-page">
        <h2 class="cart-title">Your Cart</h2>
        <p id="cart-restaurant-name" style="color:var(--text-muted);font-size:0.88rem;margin-bottom:12px;"></p>

        <div class="cart-layout">
            <div class="cart-items" id="cart-items">
                <!-- Items will be loaded here -->
            </div>

            <aside class="cart-summary">
                <h3>Order Summary</h3>
                <div class="summary-line">
                    <span>Subtotal:</span>
                    <span id="subtotal">EGP 0.00</span>
                </div>
                <div class="summary-line">
                    <span>Tax (5%):</span>
                    <span id="tax">EGP 0.00</span>
                </div>
                <div class="summary-line total">
                    <span>Total:</span>
                    <span id="total">EGP 0.00</span>
                </div>
                <button class="checkout-btn" onclick="window.location.href='/checkout'">Proceed to Checkout</button>
            </aside>
        </div>
    </main>

    <footer class="sh-footer">
        <a href="/student-home" class="sh-footer-logo">UNIEats</a>
        <span class="sh-footer-copy">Campus Dining Platform · 2026</span>
    </footer>

    <div id="toast-container"></div>

    <script src="/script/all-student.js"></script>
</body>
</html>
