<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNIEats - Restaurant Details</title>
    <link rel="stylesheet" href="/styles/colors.css">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/student.css">
</head>
<body>
    <nav class="navbar">
        <a href="javascript:history.back()" class="back-arrow show" aria-label="Go back">←</a>
        <div class="links">
            <a href="/student-home">Home</a>
            <a href="/cart">Cart</a>
            <a href="/profile">Profile</a>
            <a href="#" onclick="confirmLogout(event)">Logout</a>
        </div>
    </nav>

    <main class="container details-container">
        <div class="restaurant-header">
            <!-- All fields populated dynamically from the DB -->
            <h2 id="rest-name">Loading…</h2>
            <div class="meta-info">
                <span class="rating" id="rest-rating"></span>
                <span class="delivery-time" id="rest-delivery"></span>
            </div>
            <p class="description" id="rest-description"></p>
        </div>

        <div class="menu-section">
            <h3>Menu</h3>
            <div id="menu"></div>
        </div>
    </main>

    <footer class="sh-footer">
        <a href="/student-home" class="sh-footer-logo">UNIEats</a>
        <span class="sh-footer-copy">Campus Dining Platform · 2026</span>
    </footer>

    <script src="/script/all-student.js"></script>
</body>
</html>
