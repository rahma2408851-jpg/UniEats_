<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNIEats - Login</title>
    <link rel="stylesheet" href="/styles/colors.css">
    <link rel="stylesheet" href="/styles/app.css">
</head>
<body>

    <nav class="navbar">
        <a href="/" class="back-arrow show" aria-label="Back to Home">←</a>
        <div class="brand">
            <div class="logo">UNIEats</div>
            <span class="badge">Login</span>
        </div>
        <div class="links">
            <a href="/">Home</a>
            <a href="/login" class="active">Login</a>
            <a href="/register">Register</a>
        </div>
    </nav>

    <main class="page-shell">
        <div class="form-card">
            <form action="/api/auth/login" method="POST" id="loginForm">
                <div class="form-eyebrow">Sign in</div>
                <h2 class="form-title">Welcome<br><em>Back.</em></h2>
                <p class="form-sub">Enter your credentials to access your account.</p>

                <div class="input-group">
                    <div class="input-header"><label for="login_identifier">Email Address</label></div>
                    <input type="email" name="email" id="login_identifier" placeholder="e.g. ahmed@restaurant.com" required>
                    <p class="input-help">Your email determines your role — student, owner, or admin.</p>
                </div>

                <div class="input-group">
                    <div class="input-header"><label for="password">Password</label></div>
                    <input type="password" name="password" id="password" placeholder="At least 6 characters" required>
                </div>

                <button type="submit">Sign In</button>

                <div class="auth-links">
                    <p>Don't have an account? <a href="/register">Register here</a></p>
                    <p><a href="/forgot-password">Forgot Password?</a></p>
                </div>
            </form>
        </div>
    </main>

</body>
</html>