<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNIEats — Reset Password</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/styles/colors.css">
    <link rel="stylesheet" href="/styles/app.css">
</head>
<body>

    <nav class="navbar">

        <a href="/login" class="back-arrow show" aria-label="Back to Login">←</a>

        <div class="brand">
            <div class="logo">UNIEats</div>
            <span class="badge">Reset Password</span>
        </div>

        <div class="links">
            <a href="/">Home</a>
            <a href="/login">Login</a>
        </div>

    </nav>

    <main class="page-shell">

        <div class="form-card">

            <div class="form-eyebrow">
                New password
            </div>

            <h2 class="form-title">
                Set your<br>
                <em>Password.</em>
            </h2>

            <p class="form-sub">
                Choose a strong password for your account.
            </p>

            <!-- Token Error -->
            <div id="token-error"
                 class="toast toast-error"
                 style="display:none;">

                <span class="toast-icon">⚠️</span>

                <span>
                    Missing or invalid reset link.
                    Please use the Forgot Password page again.
                </span>
            </div>

            <form id="reset-password-form">

                <div class="input-group">

                    <div class="input-header">
                        <label for="new-password">
                            New Password
                        </label>
                    </div>

                    <input
                        type="password"
                        id="new-password"
                        placeholder="Min. 6 characters"
                        required
                    >

                </div>

                <div class="input-group">

                    <div class="input-header">
                        <label for="confirm-password">
                            Confirm Password
                        </label>
                    </div>

                    <input
                        type="password"
                        id="confirm-password"
                        placeholder="Repeat your password"
                        required
                    >

                    <span id="match-error"
                          class="error-msg"
                          style="display:none;">

                        Passwords do not match.

                    </span>

                </div>

                <button type="submit" id="submitBtn">
                    Reset Password
                </button>

            </form>

            <div class="auth-links">
                <p>
                    <a href="/login">← Back to Login</a>
                </p>
            </div>

        </div>
    </main>

    <script>

        const token =
            new URLSearchParams(window.location.search)
            .get('token');

        if (!token) {

            document.getElementById("token-error")
                .style.display = "flex";

            document.getElementById("submitBtn")
                .disabled = true;
        }

        const newPwd     = document.getElementById('new-password');
        const confirmPwd = document.getElementById('confirm-password');
        const matchError = document.getElementById('match-error');

        function validateMatch() {

            const mismatch =
                confirmPwd.value &&
                newPwd.value !== confirmPwd.value;

            matchError.style.display =
                mismatch ? 'block' : 'none';

            confirmPwd.style.borderColor =
                mismatch ? 'var(--danger)' : '';

            return !mismatch;
        }

        newPwd.addEventListener('input', validateMatch);
        confirmPwd.addEventListener('input', validateMatch);

        document
            .getElementById('reset-password-form')
            .addEventListener('submit', async (e) => {

                e.preventDefault();

                if (!validateMatch()) return;

                const btn = document.getElementById('submitBtn');

                btn.textContent = "Resetting…";
                btn.disabled = true;

                try {

                    const res = await fetch('/api/auth/reset-password', {
                        method : 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body : JSON.stringify({
                            token,
                            password: newPwd.value
                        })
                    });

                    const data = await res.json();

                    if (!res.ok) {
                        throw new Error(
                            data.error || 'Reset failed.'
                        );
                    }

                    btn.textContent = "Password Reset! Redirecting…";

                    btn.style.background = 'var(--success)';

                    setTimeout(() => {
                        window.location.href = "/login";
                    }, 1500);

                } catch (err) {

                    btn.textContent = "Reset Password";
                    btn.disabled = false;

                    matchError.textContent = err.message;
                    matchError.style.display = 'block';
                }
            });

    </script>

</body>
</html>